# .env.example
# Copy to .env and fill in values.
# Loaded automatically by scripts/demo.sh (arrives in 26Q3-REPO-12).
# Never commit .env — it is gitignored.

# ── Required ──────────────────────────────────────────────────────────────────
# Absolute path to the host directory containing model checkpoints.
# demo.sh mounts this read-only at /checkpoints inside the container.
CHECKPOINTS_DIR=/path/to/your/checkpoints

# ── Demo model configuration ──────────────────────────────────────────────────
# Choose ONE of the two modes below.
#
# Mode A — single model: name the checkpoint FILE inside CHECKPOINTS_DIR.
# demo.sh resolves it to /checkpoints/<file> in the container, so you state the
# directory once (above) and the filename once (here) — no repeated paths.
DEMO_CHECKPOINT_FILE=your-merged-checkpoint.pt

# Mode B — language routing: point at a routing YAML instead (overrides Mode A).
# DEMO_LANGUAGES_CONFIG=/app/configs/serving/demo_languages.yaml

# Advanced: set a full in-container path to bypass the CHECKPOINTS_DIR +
# DEMO_CHECKPOINT_FILE resolution entirely.
# DEMO_CHECKPOINT=/checkpoints/xeus-demo

DEMO_MODEL_TYPE=xeus
DEMO_DECODER=ctc_greedy

# ── Network ───────────────────────────────────────────────────────────────────
# DEMO_PORT=7860
# DEMO_BIND=127.0.0.1   # set to 0.0.0.0 for local-network / conference exposure

# ── Path overrides ────────────────────────────────────────────────────────────
# FLAIME_SIF=flaime-demo.sif
